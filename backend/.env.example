# Application
APP_NAME=FraudGuard AI Platform
APP_ENV=development
DEBUG=true

# Database
# Local default is SQLite. For PostgreSQL / Neon / Render use:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fraudguard?sslmode=require
DATABASE_URL=sqlite:///./fraudguard.db

# JWT — set a long random value in production. Never expose this to the browser.
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated frontend origins (no wildcard in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ML
# MODEL_PATH=app/models/fraud_model.pkl
MAX_CSV_ROWS=5000
FRAUD_THRESHOLD=0.5
